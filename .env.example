# Copie este arquivo para .env e preencha os valores reais.
# Nunca commitar o .env preenchido.

# Caminho do banco SQLite (relativo a raiz do projeto)
DATABASE_URL=sqlite:///data/database.sqlite

# Preenchidos nas fases 4 e 5 (nao necessarios na Sprint 1)
CLAUDE_API_KEY=
TELEGRAM_TOKEN=

# Board tokens do Greenhouse a rastrear, separados por virgula (ex: spotify,notion,figma).
# Ver docs/po-backlog.md - lista de empresas ainda depende de decisao da Clara.
GREENHOUSE_BOARD_TOKENS=
